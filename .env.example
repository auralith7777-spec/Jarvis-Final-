# ---- required for the web service ----
ADMIN_PASSWORD=change-me-to-something-long
# Optional. Random string to sign login cookies. If empty it is derived from ADMIN_PASSWORD.
# SESSION_SECRET=

# ---- agents: add the keys you have (2-3 enables cross-checking). No keys = offline demo agents. ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model names change often. Set these to the current model IDs from each provider's docs.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro

# Optional price overrides (USD per 1M tokens). Defaults in src/connectors are PLACEHOLDERS.
# ANTHROPIC_PRICE_IN=3
# ANTHROPIC_PRICE_OUT=15
# OPENAI_PRICE_IN=2.5
# OPENAI_PRICE_OUT=10
# GEMINI_PRICE_IN=1.25
# GEMINI_PRICE_OUT=10

# ---- storage ----
# Leave empty locally (jobs saved in ./data). On Render, set to your Postgres Internal Database URL.
# DATABASE_URL=
# PGSSL=1   # only if you use an EXTERNAL database URL

# Force offline demo agents even if keys exist
# USE_MOCK=1
